# Metaware IG credentials (Instagram Login flow — no FB Page needed)
# Obtain via developers.facebook.com → crade app → Instagram → API setup with Instagram login
# → Generate access tokens → Add account (login as @metawareai)

METAWARE_INSTAGRAM_ACCESS_TOKEN=IGAA...
METAWARE_INSTAGRAM_USER_ID=...

# Optional (used for token refresh script — not required for posting)
METAWARE_FB_APP_ID=...
METAWARE_INSTAGRAM_APP_ID=...
